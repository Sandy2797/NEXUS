{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS Security Event",
  "description": "NEXUS SecurityEvent contract, version 1.0.0; proposed pending team approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
  "type": "string",
  "minLength": 1,
  "maxLength": 100
},
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["wireless", "android_api", "privacy_guard", "system_log"]
    },
    "finding_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "asset_or_subject": {
      "type": ["string", "null"],
      "maxLength": 250
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence_reference": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "rule_or_model_version": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "policy_decision": {
      "enum": ["allow", "redact", "block", "approval_required", null]
    },
    "enforcement_result": {
      "type": "string",
      "enum": ["not_applicable", "forwarded", "redacted", "blocked", "pending_approval", "failed"]
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "timestamp",
    "source",
    "finding_type",
    "severity",
    "summary",
    "enforcement_result"
  ]
}